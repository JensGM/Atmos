cabal-version:      2.4
name:               atmos
version:            0.1.0.0
synopsis:           Haskell atmos prototype used to evaluate a wasm build
description:
  A subset of atmos in Haskell, written to answer one question: what does
  compiling atmos to wasm32-wasi cost, and what has to change about storage to
  get there.  Depends only on GHC boot libraries so that it builds with a stock
  GHC and with wasm32-wasi-ghc from the same sources.

license:            LGPL-3.0-only
build-type:         Simple

library
  exposed-modules:
    Atmos.Codec
    Atmos.Link
    Atmos.Store
    Atmos.Store.Files
    Atmos.Store.SingleFile
    Atmos.Types

  hs-source-dirs:   src
  build-depends:
    , base        >=4.14 && <5
    , containers
    , directory
    , filepath
    , unix

  default-language: Haskell2010
  ghc-options:      -Wall

executable atmos
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , atmos
    , base
    , directory
    , filepath

  default-language: Haskell2010
  ghc-options:      -Wall

executable atmos-bench
  main-is:          Bench.hs
  hs-source-dirs:   bench
  build-depends:
    , atmos
    , base
    , directory
    , filepath
    , time

  default-language: Haskell2010
  ghc-options:      -Wall
